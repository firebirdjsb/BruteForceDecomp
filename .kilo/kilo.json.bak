
{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "rea": {
      "type": "local",
      "command": [
        "cmd",
        "/d",
        "/c",
        "npx",
        "-y",
        "rea-agents@6.8.0",
        "mcp"
      ],
      "environment": {
        "GHIDRA_INSTALL_DIR": "D:\\Downloads\\ghidra_12.1.4_PUBLIC",
        "REA_ANALYSIS_PROVIDER": "ghidra"
      },
      "enabled": true,
      "timeout": 360000
    }
  }
}
